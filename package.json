{
  "name": "viralreel-ai-studio",
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.sites-worker.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "schema:build": "node scripts/build-full-schema.mjs",
    "schema:check": "node scripts/build-full-schema.mjs --check",
    "test:unit": "vitest run",
    "test": "npm run typecheck && npm run schema:check && npm run test:unit && npm run build"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@supabase/supabase-js": "^2.95.3",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.16.0",
    "mp4-muxer": "^5.2.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@openai/sites-vite-plugin": "0.2.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.8.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.11"
  }
}
